-- Separate table outputs

-- Movies table
SELECT
  movie_id,
  title,
  release_year,
  genre,
  rating
FROM movies
ORDER BY rating DESC, release_year ASC, title ASC;

-- Movie reviews table
SELECT
  review_id,
  movie_id,
  review
FROM movie_reviews
ORDER BY review_id ASC;

-- Insights

-- The separate movies and movie_reviews table outputs above already show
-- all 15 movies and their reviews, so duplicate top-15 result sets are omitted.

-- 2. Movie ratings by release year
SELECT
  release_year,
  COUNT(*) AS movie_count,
  ROUND(AVG(rating), 2) AS average_rating,
  MAX(rating) AS highest_rating,
  MIN(rating) AS lowest_rating
FROM movies
GROUP BY release_year
ORDER BY release_year ASC;

-- 3. Average movie rating by genre
SELECT
  genre,
  COUNT(*) AS movie_count,
  ROUND(AVG(rating), 2) AS average_rating,
  MAX(rating) AS highest_rating
FROM movies
GROUP BY genre
ORDER BY average_rating DESC, genre ASC;

-- 4. Best-reviewed movies with a rating of 9.0 or higher
SELECT
  title,
  genre,
  m.rating,
  r.review
FROM movies AS m
JOIN movie_reviews AS r ON r.movie_id = m.movie_id
WHERE m.rating >= 9.0
ORDER BY m.rating DESC, m.title ASC;

-- 5. Longest written reviews
SELECT
  m.title,
  m.rating,
  CHAR_LENGTH(r.review) AS review_length,
  r.review
FROM movies AS m
JOIN movie_reviews AS r ON r.movie_id = m.movie_id
ORDER BY review_length DESC, m.rating DESC
LIMIT 5;

-- 6. Movies released by decade
SELECT
  CONCAT(decade_start, 's') AS release_decade,
  COUNT(*) AS movie_count,
  ROUND(AVG(rating), 2) AS average_rating,
  MAX(rating) AS highest_rating
FROM (
  SELECT
    release_year - MOD(release_year, 10) AS decade_start,
    rating
  FROM movies
) AS decade_movies
GROUP BY decade_start
ORDER BY decade_start;

-- 7. Overall rating summary
SELECT
  COUNT(*) AS total_movies,
  ROUND(AVG(rating), 2) AS overall_average_rating,
  MAX(rating) AS top_rating,
  MIN(rating) AS lowest_rating
FROM movies;

